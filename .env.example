# EXAMPLE ONLY. Set these in your shell/IDE or a private configuration mechanism.
# Spring Boot does not automatically load .env files.
# Tests use synthetic configuration and need NONE of the runtime values below.
SPRING_DATASOURCE_URL=
SPRING_DATASOURCE_USERNAME=
SPRING_DATASOURCE_PASSWORD=
# Supply a stable random signing key of at least 32 bytes for the runtime app.
JWT_SECRET=
# Required only when intentionally initializing an empty runtime database.
APP_BOOTSTRAP_ADMIN_PASSWORD=
# Optional: use separate storage for every non-production environment.
APP_UPLOAD_DIR=./uploads

# One-time upgrade only: exact username of the enabled legacy ADMIN chosen as manager.
APP_INITIAL_MANAGER_USERNAME=
